{
  "name": "bladeclient-launcher",
  "version": "0.2.9-Beta-1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "7zip-bin": "^5.2.0",
    "archiver": "^6.0.2",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.1.7",
    "extract-zip": "^2.0.1",
    "lucide-vue-next": "^1.0.0",
    "minecraft-launcher-core": "^3.13.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^32.2.2",
    "electron-builder": "^24.13.3",
    "sass-embedded": "^1.100.0",
    "vite": "^5.4.8",
    "vue": "^3.5.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ir.modernshadow.bladeclient.launcher",
    "productName": "BladeClient Launcher",
    "asar": true,
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "compression": "maximum",
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "!**/node_modules/.bin",
      "!**/node_modules/**/{CHANGELOG.md,README.md,readme.md,README,LICENSE,license,license.md,LICENCE,*.d.ts}",
      "!**/__tests__/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/.cache/**"
    ],
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist-reales",
      "buildResources": "public"
    },
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://blade.runflare.run/launcher"
    }
  }
}
